+#include <linux/delay.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regulator/consumer.h>
+
+#include <drm/drm_bridge.h>
+#include <drm/drm_of.h>
+#include <drm/drm_panel.h>
+
+struct it6251_bridge {
+        struct drm_bridge bridge;
+        struct drm_bridge *next_bridge;
+
+        struct i2c_client *client;
+        struct i2c_client *lvds_client;
+        struct regulator *regulator;
+
+        bool powered;
+};
+
+#define IT6251_VENDOR_ID_LOW                    0x00
+#define IT6251_VENDOR_ID_HIGH                   0x01
+#define IT6251_DEVICE_ID_LOW                    0x02
+#define IT6251_DEVICE_ID_HIGH                   0x03
+
+#define IT6251_SYSTEM_STATUS                    0x0d
+#define IT6251_SYSTEM_STATUS_RINTSTATUS         BIT(0)
+#define IT6251_SYSTEM_STATUS_RHPDSTATUS         BIT(1)
+#define IT6251_SYSTEM_STATUS_RVIDEOSTABLE       BIT(2)
+#define IT6251_SYSTEM_STATUS_RPLL_IOLOCK        BIT(3)
+#define IT6251_SYSTEM_STATUS_RPLL_XPLOCK        BIT(4)
+#define IT6251_SYSTEM_STATUS_RPLL_SPLOCK        BIT(5)
+#define IT6251_SYSTEM_STATUS_RAUXFREQ_LOCK      BIT(6)
+
+#define IT6251_REF_STATE                        0x0e
+#define IT6251_REF_STATE_MAIN_LINK_DISABLED     BIT(0)
+#define IT6251_REF_STATE_AUX_CHANNEL_READ       BIT(1)
+#define IT6251_REF_STATE_CR_PATTERN             BIT(2)
+#define IT6251_REF_STATE_EQ_PATTERN             BIT(3)
+#define IT6251_REF_STATE_NORMAL_OPERATION       BIT(4)
+#define IT6251_REF_STATE_MUTED                  BIT(5)
+
+#define IT6251_RPC_REQ                          0x2b
+#define IT6251_RPC_REQ_RPC_FIFOFULL             BIT(6)
+#define IT6251_RPC_REQ_RPC_FIFOEMPTY            BIT(7)
+
+#define IT6251_REG_PCLK_CNT_LOW                 0x57
+#define IT6251_REG_PCLK_CNT_HIGH                0x58
+
+#define IT6251_REG_LVDS_PORT_ADDR               0xfd
+#define IT6251_REG_LVDS_PORT_CTRL               0xfe
+#define IT6251_REG_LVDS_PORT_CTRL_EN            BIT(0)
+
+#define IT6251_LVDS_ADDR                        0x5e
+
+static int it6251_write(struct it6251_bridge *priv, u8 addr, u8 val)
+{
+        u8 buf[2] = { addr, val };
+        int ret;
+
+        ret = i2c_master_send(priv->client, buf, ARRAY_SIZE(buf));
+        if (ret < 0) {
+                dev_err(&priv->client->dev,
+                        "error %d writing to eDP addr 0x%x\n",
+                        ret, addr);
+                return ret;
+        }
+
+        if (ret != ARRAY_SIZE(buf))
+                return -EIO;
+
+        return 0;
+}
+
+static int it6251_lvds_write(struct it6251_bridge *priv, u8 addr, u8 val)
+{
+        u8 buf[2] = { addr, val };
+        int ret;
+
+        ret = i2c_master_send(priv->lvds_client, buf, ARRAY_SIZE(buf));
+        if (ret < 0) {
+                dev_err(&priv->client->dev,
+                        "error %d writing to LVDS addr 0x%x\n",
+                        ret, addr);
+                return ret;
+        }
+
+        if (ret != ARRAY_SIZE(buf))
+                return -EIO;
+
+        return 0;
+}
+
+static int it6251_read_client(struct i2c_client *client, u8 addr)
+{
+        u8 val;
+        int ret;
+
+        ret = i2c_master_send(client, &addr, sizeof(addr));
+        if (ret < 0) {
+                dev_err(&client->dev,
+                        "DEBUG: read subaddress 0x%x: SEND failed ret=%d\n",
+                        addr, ret);
+                return ret;
+        }
+
+        if (ret != sizeof(addr)) {
+                dev_err(&client->dev,
+                        "DEBUG: read subaddress 0x%x: SEND short transfer ret=%d expected=%zu\n",
+                        addr, ret, sizeof(addr));
+                return -EIO;
+        }
+
+        dev_info(&client->dev,
+                 "DEBUG: read subaddress 0x%x: SEND succeeded\n",
+                 addr);
+
+        ret = i2c_master_recv(client, &val, sizeof(val));
+        if (ret < 0) {
+                dev_err(&client->dev,
+                        "DEBUG: read subaddress 0x%x: RECV failed ret=%d\n",
+                        addr, ret);
+                return ret;
+        }
+
+        if (ret != sizeof(val)) {
+                dev_err(&client->dev,
+                        "DEBUG: read subaddress 0x%x: RECV short transfer ret=%d expected=%zu\n",
+                        addr, ret, sizeof(val));
+                return -EIO;
+        }
+
+        dev_info(&client->dev,
+                 "DEBUG: read subaddress 0x%x: RECV succeeded value=0x%02x\n",
+                 addr, val);
+
+        return val;
+}
+
+static int it6251_read(struct it6251_bridge *priv, u8 addr)
+{
+        return it6251_read_client(priv->client, addr);
+}
+
+static int it6251_lvds_read(struct it6251_bridge *priv, u8 addr)
+{
+        return it6251_read_client(priv->lvds_client, addr);
+}
+
+static bool it6251_is_stable(struct it6251_bridge *priv)
+{
+        int status;
+        int rpclkcnt;
+        int clkcnt;
+        int refstate;
+        int rpcreq;
+        int lo;
+        int hi;
+        u16 hactive;
+        u16 vactive;
+
+        dev_info(&priv->client->dev,
+                 "DEBUG: is_stable: enter\n");
+
+        status = it6251_read(priv, IT6251_SYSTEM_STATUS);
+        if (status < 0)
+                return false;
+
+        dev_info(&priv->client->dev,
+                 "System status: 0x%02x\n",
+                 status);
+
+        if (!(status & IT6251_SYSTEM_STATUS_RVIDEOSTABLE))
+                return false;
+
+        lo = it6251_read(priv, 0x13);
+        hi = it6251_read(priv, 0x14);
+        if (lo < 0 || hi < 0)
+                return false;
+
+        rpclkcnt = (lo & 0xff) | ((hi << 8) & 0x0f00);
+
+        dev_info(&priv->client->dev,
+                 "RPCLKCnt: %d\n",
+                 rpclkcnt);
+
+        lo = it6251_lvds_read(priv, IT6251_REG_PCLK_CNT_LOW);
+        hi = it6251_lvds_read(priv, IT6251_REG_PCLK_CNT_HIGH);
+        if (lo < 0 || hi < 0)
+                return false;
+
+        clkcnt = (lo & 0xff) | ((hi << 8) & 0x0f00);
+
+        dev_info(&priv->client->dev,
+                 "Clock: 0x%03x\n",
+                 clkcnt);
+
+        refstate = it6251_lvds_read(priv, IT6251_REF_STATE);
+        if (refstate < 0)
+                return false;
+
+        dev_info(&priv->client->dev,
+                 "Ref Link State: 0x%02x\n",
+                 refstate);
+
+        rpcreq = it6251_lvds_read(priv, IT6251_RPC_REQ);
+        if (rpcreq < 0)
+                return false;
+
+        dev_info(&priv->client->dev,
+                 "RPC Req: 0x%02x\n",
+                 rpcreq);
+
+        lo = it6251_read(priv, 0xa5);
+        hi = it6251_read(priv, 0xa6);
+        if (lo < 0 || hi < 0)
+                return false;
+
+        hactive = lo;
+        hactive |= (hi & 0x1f) << 8;
+
+        dev_info(&priv->client->dev,
+                 "hactive: %u\n",
+                 hactive);
+
+        lo = it6251_read(priv, 0xaf);
+        hi = it6251_read(priv, 0xb0);
+        if (lo < 0 || hi < 0)
+                return false;
+
+        vactive = lo;
+        vactive |= (hi & 0x0f) << 8;
+
+        dev_info(&priv->client->dev,
+                 "vactive: %u\n",
+                 vactive);
+
+        if ((refstate & 0x1f) != 0)
+                return false;
+
+        if (rpcreq & IT6251_RPC_REQ_RPC_FIFOFULL) {
+                dev_err(&priv->client->dev,
+                        "RPC FIFO full is set\n");
+                return false;
+        }
+
+        if (refstate & IT6251_REF_STATE_MUTED)
+                return false;
+
+        /*
+         * The Novena panel is 1920x1080.
+         *
+         * The historical driver first compared against the modes
+         * attached to the panel connector and used vactive == 1080
+         * as a fallback.  The modern panel bridge owns that connector,
+         * so use the known Novena mode here.
+         */
+        if (hactive == 1920 && vactive == 1080) {
+                dev_info(&priv->client->dev,
+                         "DEBUG: is_stable: stable 1920x1080\n");
+                return true;
+        }
+
+        if (vactive == 1080) {
+                dev_info(&priv->client->dev,
+                         "DEBUG: is_stable: stable via vactive fallback\n");
+                return true;
+        }
+
+        dev_info(&priv->client->dev,
+                 "DEBUG: is_stable: not stable\n");
+
+        return false;
+}
+
+static int it6251_init(struct it6251_bridge *priv)
+{
+        int reg;
+        int tries;
+
+        dev_info(&priv->client->dev,
+                 "DEBUG: init: enter\n");
+
+        /*
+         * Reset DisplayPort half.
+         *
+         * The original Novena driver notes that setting bit 2 causes
+         * the IT6251 to stop responding over I2C temporarily.  An I2C
+         * failure reported for the reset write is therefore expected.
+         */
+        dev_info(&priv->client->dev,
+                 "DEBUG: init: resetting DisplayPort half\n");
+
+        it6251_write(priv, 0x05, 0xff);
+        it6251_write(priv, 0x05, 0x00);
+
+        /*
+         * Configure the LVDS receiver half at I2C address 0x5e.
+         */
+        dev_info(&priv->client->dev,
+                 "DEBUG: init: configuring LVDS I2C port\n");
+
+        it6251_write(priv,
+                     IT6251_REG_LVDS_PORT_ADDR,
+                     IT6251_LVDS_ADDR << 1);
+
+        it6251_write(priv,
+                     IT6251_REG_LVDS_PORT_CTRL,
+                     IT6251_REG_LVDS_PORT_CTRL_EN);
+
+        /*
+         * LVDSRX reset.
+         */
+        dev_info(&priv->client->dev,
+                 "DEBUG: init: resetting LVDSRX\n");
+
+        it6251_lvds_write(priv, 0x05, 0xff);
+        it6251_lvds_write(priv, 0x05, 0x00);
+
+        /*
+         * Reset LVDSRX PLL.
+         */
+        it6251_lvds_write(priv, 0x3b, 0x42);
+        it6251_lvds_write(priv, 0x3b, 0x43);
+
+        /*
+         * Historical Novena LVDSRX configuration.
+         */
+        it6251_lvds_write(priv, 0x3c, 0x08);
+        it6251_lvds_write(priv, 0x0b, 0x88);
+
+        /*
+         * JEIDA, 8-bit depth.
+         */
+        it6251_lvds_write(priv, 0x2c, 0x01);
+        it6251_lvds_write(priv, 0x32, 0x04);
+        it6251_lvds_write(priv, 0x35, 0xe0);
+        it6251_lvds_write(priv, 0x2b, 0x24);
+
+        /*
+         * Reset LVDSRX pixel clock.
+         */
+        it6251_lvds_write(priv, 0x05, 0x02);
+        it6251_lvds_write(priv, 0x05, 0x00);
+
+        dev_info(&priv->client->dev,
+                 "DEBUG: init: LVDSRX programming complete\n");
+
+        /*
+         * DisplayPort transmitter.
+         */
+        it6251_write(priv, 0x16, 0x02);
+
+        it6251_write(priv, 0x23, 0x40);
+
+        /*
+         * Power down lanes 3-0 while configuring.
+         */
+        it6251_write(priv, 0x5c, 0xf3);
+
+        it6251_write(priv, 0x5f, 0x06);
+
+        /*
+         * RGB input, pixel clock / 2.
+         */
+        it6251_write(priv, 0x60, 0x02);
+
+        /*
+         * Dual pixel input.
+         */
+        it6251_write(priv, 0x61, 0x04);
+
+        /*
+         * M444B24 video format.
+         */
+        it6251_write(priv, 0x62, 0x01);
+
+        /*
+         * VESA range, progressive, VSYNC/HSYNC high.
+         */
+        it6251_write(priv, 0xa0, 0x0f);
+
+        /*
+         * HPD event timer.
+         */
+        it6251_write(priv, 0xc9, 0xf5);
+
+        /*
+         * Historical reserved programming.
+         */
+        it6251_write(priv, 0xca, 0x4d);
+        it6251_write(priv, 0xcb, 0x37);
+
+        /*
+         * Enhanced framing mode, automatic video FIFO reset,
+         * video mute disabled.
+         */
+        it6251_write(priv, 0xd3, 0x03);
+
+        it6251_write(priv, 0xd4, 0x45);
+
+        it6251_write(priv, 0xe7, 0xa0);
+        it6251_write(priv, 0xe8, 0x33);
+        it6251_write(priv, 0xec, 0x00);
+
+        /*
+         * AUX channel programming.
+         */
+        it6251_write(priv, 0x23, 0x42);
+
+        it6251_write(priv, 0x24, 0x00);
+        it6251_write(priv, 0x25, 0x00);
+        it6251_write(priv, 0x26, 0x00);
+
+        it6251_write(priv, 0x2b, 0x00);
+
+        it6251_write(priv, 0x23, 0x40);
+
+        /*
+         * Maximum voltage swing / pre-emphasis.
+         */
+        it6251_write(priv, 0x19, 0xff);
+        it6251_write(priv, 0x1a, 0xff);
+
+        dev_info(&priv->client->dev,
+                 "DEBUG: init: DisplayPort programming complete\n");
+
+        /*
+         * Start DisplayPort link training.
+         */
+        dev_info(&priv->client->dev,
+                 "DEBUG: init: starting link training\n");
+
+        it6251_write(priv, 0x17, 0x01);
+
+        /*
+         * The historical Novena driver watches the DPTX 0x0e
+         * reference-state register here.  Normal operation is 0x10
+         * in its low five bits.
+         */
+        for (tries = 0; tries < 100; tries++) {
+                reg = it6251_read(priv, IT6251_REF_STATE);
+
+                if (reg >= 0 &&
+                    (reg & 0x1f) ==
+                    IT6251_REF_STATE_NORMAL_OPERATION) {
+                        reg = it6251_read(priv,
+                                         IT6251_SYSTEM_STATUS);
+
+                        if (reg >= 0 &&
+                            (reg &
+                             IT6251_SYSTEM_STATUS_RVIDEOSTABLE))
+                                break;
+                }
+
+                udelay(2000);
+        }
+
+        dev_info(&priv->client->dev,
+                 "DEBUG: init: link training loop finished after %d iterations\n",
+                 tries);
+
+        if (it6251_is_stable(priv)) {
+                dev_info(&priv->client->dev,
+                         "display link stable\n");
+                dev_info(&priv->client->dev,
+                         "DEBUG: init: exit success\n");
+                return 0;
+        }
+
+        dev_err(&priv->client->dev,
+                "display link did not stabilize\n");
+
+        dev_info(&priv->client->dev,
+                 "DEBUG: init: exit failure\n");
+
+        return -EIO;
+}
+
+static int it6251_power_up(struct it6251_bridge *priv)
+{
+        struct device *dev = &priv->client->dev;
+        int vendor_id_lo = -1;
+        int vendor_id_hi = -1;
+        int device_id_lo = -1;
+        int device_id_hi = -1;
+        int ret;
+        int i;
+
+        dev_info(dev,
+                 "DEBUG: power_up: enter powered=%d\n",
+                 priv->powered);
+
+        if (priv->powered) {
+                dev_info(dev,
+                         "DEBUG: power_up: already powered\n");
+                return 0;
+        }
+
+        dev_info(dev,
+                 "DEBUG: power_up: regulator_enable\n");
+
+        ret = regulator_enable(priv->regulator);
+        if (ret)
+                return dev_err_probe(dev,
+                                     ret,
+                                     "unable to enable regulator\n");
+
+        priv->powered = true;
+
+        dev_info(dev,
+                 "DEBUG: power_up: regulator enabled\n");
+
+        /*
+         * Sometimes several attempts are required before the
+         * IT6251 responds after power-up.  Preserve the original
+         * Novena driver's behaviour.
+         */
+        for (i = 0; i < 5; i++) {
+                dev_info(dev,
+                         "DEBUG: power_up: product ID attempt %d/5\n",
+                         i + 1);
+
+                vendor_id_lo =
+                        it6251_read(priv, IT6251_VENDOR_ID_LOW);
+
+                vendor_id_hi =
+                        it6251_read(priv, IT6251_VENDOR_ID_HIGH);
+
+                device_id_lo =
+                        it6251_read(priv, IT6251_DEVICE_ID_LOW);
+
+                device_id_hi =
+                        it6251_read(priv, IT6251_DEVICE_ID_HIGH);
+
+                if (vendor_id_lo >= 0 &&
+                    vendor_id_hi >= 0 &&
+                    device_id_lo >= 0 &&
+                    device_id_hi >= 0)
+                        break;
+
+                dev_info(dev,
+                         "DEBUG: power_up: product ID read incomplete, sleeping\n");
+
+                usleep_range(100000, 200000);
+        }
+
+        if (vendor_id_lo < 0 ||
+            vendor_id_hi < 0 ||
+            device_id_lo < 0 ||
+            device_id_hi < 0) {
+                dev_err(dev,
+                        "unable to read product ID\n");
+
+                dev_info(dev,
+                         "DEBUG: power_up: disabling regulator after ID failure\n");
+
+                ret = regulator_disable(priv->regulator);
+                if (ret)
+                        dev_err(dev,
+                                "unable to disable regulator: %d\n",
+                                ret);
+
+                priv->powered = false;
+
+                dev_info(dev,
+                         "DEBUG: power_up: exit failure\n");
+
+                return -EIO;
+        }
+
+        dev_info(dev,
+                 "IT6251 detected: vendor %02x%02x device %02x%02x\n",
+                 vendor_id_hi,
+                 vendor_id_lo,
+                 device_id_hi,
+                 device_id_lo);
+
+        dev_info(dev,
+                 "DEBUG: power_up: exit success\n");
+
+        return 0;
+}
+
+static void it6251_power_down(struct it6251_bridge *priv)
+{
+        int ret;
+
+        dev_info(&priv->client->dev,
+                 "DEBUG: power_down: enter powered=%d\n",
+                 priv->powered);
+
+        if (!priv->powered) {
+                dev_info(&priv->client->dev,
+                         "DEBUG: power_down: already off\n");
+                return;
+        }
+
+        dev_info(&priv->client->dev,
+                 "DEBUG: power_down: regulator_disable\n");
+
+        ret = regulator_disable(priv->regulator);
+        if (ret) {
+                dev_err(&priv->client->dev,
+                        "unable to disable regulator: %d\n",
+                        ret);
+                dev_info(&priv->client->dev,
+                         "DEBUG: power_down: regulator_disable failed\n");
+                return;
+        }
+
+        priv->powered = false;
+
+        dev_info(&priv->client->dev,
+                 "DEBUG: power_down: exit success\n");
+}
+
+static void it6251_bridge_pre_enable(struct drm_bridge *bridge)
+{
+        struct it6251_bridge *priv =
+                container_of(bridge,
+                             struct it6251_bridge,
+                             bridge);
+        int ret;
+
+        dev_info(&priv->client->dev,
+                 "DEBUG: bridge_pre_enable: enter\n");
+
+        ret = it6251_power_up(priv);
+        if (ret)
+                dev_err(&priv->client->dev,
+                        "unable to power up IT6251: %d\n",
+                        ret);
+
+        dev_info(&priv->client->dev,
+                 "DEBUG: bridge_pre_enable: exit ret=%d powered=%d\n",
+                 ret,
+                 priv->powered);
+}
+
+static void it6251_bridge_enable(struct drm_bridge *bridge)
+{
+        struct it6251_bridge *priv =
+                container_of(bridge,
+                             struct it6251_bridge,
+                             bridge);
+        int tries;
+
+        dev_info(&priv->client->dev,
+                 "DEBUG: bridge_enable: enter powered=%d\n",
+                 priv->powered);
+
+        if (!priv->powered) {
+                dev_err(&priv->client->dev,
+                        "cannot initialize unpowered IT6251\n");
+                dev_info(&priv->client->dev,
+                         "DEBUG: bridge_enable: exit because bridge is unpowered\n");
+                return;
+        }
+
+        /*
+         * Match the original Novena driver:
+         *
+         * Try the complete initialization up to five times.  If the
+         * display link does not become stable, power-cycle the whole
+         * bridge and try again from a known hardware state.
+         */
+        for (tries = 0; tries < 5; tries++) {
+                int ret;
+
+                dev_info(&priv->client->dev,
+                         "initialization attempt %d/5\n",
+                         tries + 1);
+
+                dev_info(&priv->client->dev,
+                         "DEBUG: bridge_enable: calling init attempt %d\n",
+                         tries + 1);
+
+                ret = it6251_init(priv);
+
+                dev_info(&priv->client->dev,
+                         "DEBUG: bridge_enable: init attempt %d returned %d\n",
+                         tries + 1,
+                         ret);
+
+                if (!ret) {
+                        dev_info(&priv->client->dev,
+                                 "DEBUG: bridge_enable: exit success\n");
+                        return;
+                }
+
+                if (tries == 4)
+                        break;
+
+                dev_info(&priv->client->dev,
+                         "power-cycling IT6251 before retry\n");
+
+                dev_info(&priv->client->dev,
+                         "DEBUG: bridge_enable: calling power_down\n");
+
+                it6251_power_down(priv);
+
+                dev_info(&priv->client->dev,
+                         "DEBUG: bridge_enable: calling power_up\n");
+
+                ret = it6251_power_up(priv);
+
+                dev_info(&priv->client->dev,
+                         "DEBUG: bridge_enable: power_up returned %d\n",
+                         ret);
+
+                if (ret) {
+                        dev_err(&priv->client->dev,
+                                "unable to power-cycle IT6251: %d\n",
+                                ret);
+                        dev_info(&priv->client->dev,
+                                 "DEBUG: bridge_enable: exit after failed power-cycle\n");
+                        return;
+                }
+        }
+
+        dev_err(&priv->client->dev,
+                "IT6251 initialization failed after 5 attempts\n");
+
+        dev_info(&priv->client->dev,
+                 "DEBUG: bridge_enable: exit failure after 5 attempts\n");
+}
+
+static void it6251_bridge_post_disable(struct drm_bridge *bridge)
+{
+        struct it6251_bridge *priv =
+                container_of(bridge,
+                             struct it6251_bridge,
+                             bridge);
+
+        dev_info(&priv->client->dev,
+                 "DEBUG: bridge_post_disable: enter\n");
+
+        it6251_power_down(priv);
+
+        dev_info(&priv->client->dev,
+                 "DEBUG: bridge_post_disable: exit\n");
+}
+
+static int it6251_bridge_attach(struct drm_bridge *bridge,
+                                struct drm_encoder *encoder,
+                                enum drm_bridge_attach_flags flags)
+{
+        struct it6251_bridge *priv =
+                container_of(bridge,
+                             struct it6251_bridge,
+                             bridge);
+        int ret;
+
+        dev_info(&priv->client->dev,
+                 "DEBUG: bridge_attach: enter flags=0x%x\n",
+                 flags);
+
+        ret = drm_bridge_attach(encoder,
+                                priv->next_bridge,
+                                bridge,
+                                flags);
+
+        dev_info(&priv->client->dev,
+                 "DEBUG: bridge_attach: downstream attach returned %d\n",
+                 ret);
+
+        return ret;
+}
+
+static const struct drm_bridge_funcs it6251_bridge_funcs = {
+        .attach = it6251_bridge_attach,
+        .pre_enable = it6251_bridge_pre_enable,
+        .enable = it6251_bridge_enable,
+        .post_disable = it6251_bridge_post_disable,
+};
+
+static int it6251_probe(struct i2c_client *client)
+{
+        struct device *dev = &client->dev;
+        struct it6251_bridge *priv;
+        int ret;
+
+        dev_info(dev,
+                 "DEBUG: probe: enter addr=0x%02x\n",
+                 client->addr);
+
+        priv = devm_drm_bridge_alloc(dev,
+                                     struct it6251_bridge,
+                                     bridge,
+                                     &it6251_bridge_funcs);
+        if (IS_ERR(priv))
+                return PTR_ERR(priv);
+
+        dev_info(dev,
+                 "DEBUG: probe: bridge allocation complete\n");
+
+        priv->client = client;
+        priv->powered = false;
+
+        i2c_set_clientdata(client, priv);
+
+        dev_info(dev,
+                 "DEBUG: probe: requesting power regulator\n");
+
+        priv->regulator = devm_regulator_get(dev, "power");
+        if (IS_ERR(priv->regulator))
+                return dev_err_probe(dev,
+                                     PTR_ERR(priv->regulator),
+                                     "unable to get power regulator\n");
+
+        dev_info(dev,
+                 "DEBUG: probe: power regulator acquired\n");
+
+        /*
+         * The LVDS receiver half of the IT6251 responds at 0x5e.
+         *
+         * The historical driver creates a second I2C client for this
+         * address.  Do the same with the modern managed API.
+         */
+        dev_info(dev,
+                 "DEBUG: probe: creating LVDS dummy client at 0x%02x\n",
+                 IT6251_LVDS_ADDR);
+
+        priv->lvds_client =
+                devm_i2c_new_dummy_device(dev,
+                                          client->adapter,
+                                          IT6251_LVDS_ADDR);
+        if (IS_ERR(priv->lvds_client))
+                return dev_err_probe(
+                        dev,
+                        PTR_ERR(priv->lvds_client),
+                        "unable to create LVDS I2C client\n");
+
+        dev_info(dev,
+                 "DEBUG: probe: LVDS dummy client created\n");
+
+        /*
+         * IT6251 port@1 is connected upstream to the i.MX6 LDB.
+         * IT6251 port@0 is connected downstream to the LCD panel.
+         *
+         * Therefore look for the downstream panel/bridge on port 0.
+         */
+        {
+                struct drm_panel *panel = NULL;
+
+                dev_info(dev,
+                         "DEBUG: probe: finding downstream panel/bridge on port 0\n");
+
+                ret = drm_of_find_panel_or_bridge(dev->of_node,
+                                                  0,
+                                                  0,
+                                                  &panel,
+                                                  &priv->next_bridge);
+
+                if (ret) {
+                        printk(KERN_ERR
+                               "NOVENA-IT6251: drm_of_find_panel_or_bridge FAILED: ret=%d\n",
+                               ret);
+                        return ret;
+                }
+
+                printk(KERN_ERR
+                       "NOVENA-IT6251: downstream found: panel=%p bridge=%p\n",
+                       panel,
+                       priv->next_bridge);
+
+                if (panel) {
+                        dev_info(dev,
+                                 "DEBUG: probe: creating DRM panel bridge\n");
+
+                        priv->next_bridge =
+                                devm_drm_panel_bridge_add(dev,
+                                                         panel);
+                        if (IS_ERR(priv->next_bridge))
+                                return dev_err_probe(
+                                        dev,
+                                        PTR_ERR(priv->next_bridge),
+                                        "unable to create panel bridge\n");
+
+                        dev_info(dev,
+                                 "DEBUG: probe: panel bridge created\n");
+                }
+        }
+
+        priv->bridge.of_node = dev->of_node;
+
+        dev_info(dev,
+                 "DEBUG: probe: registering DRM bridge\n");
+
+        ret = devm_drm_bridge_add(dev, &priv->bridge);
+        if (ret)
+                return dev_err_probe(
+                        dev,
+                        ret,
+                        "unable to register DRM bridge\n");
+
+        dev_info(dev,
+                 "IT6251 DRM bridge registered\n");
+
+        dev_info(dev,
+                 "DEBUG: probe: exit success\n");
+
+        return 0;
+}
+
+static void it6251_remove(struct i2c_client *client)
+{
+        struct it6251_bridge *priv =
+                i2c_get_clientdata(client);
+
+        dev_info(&client->dev,
+                 "DEBUG: remove: enter\n");
+
+        it6251_power_down(priv);
+
+        dev_info(&client->dev,
+                 "DEBUG: remove: exit\n");
+}
+
+static const struct i2c_device_id it6251_ids[] = {
+        { "it6251", 0 },
+        { }
+};
+MODULE_DEVICE_TABLE(i2c, it6251_ids);
+
+static const struct of_device_id it6251_of_match[] = {
+        { .compatible = "it,it6251" },
+        { .compatible = "ite,it6251" },
+        { }
+};
+MODULE_DEVICE_TABLE(of, it6251_of_match);
+
+static struct i2c_driver it6251_driver = {
+        .driver = {
+                .name = "it6251",
+                .of_match_table = it6251_of_match,
+        },
+        .probe = it6251_probe,
+        .remove = it6251_remove,
+        .id_table = it6251_ids,
+};
+
+module_i2c_driver(it6251_driver);
+
+MODULE_AUTHOR("Sean Cross <xobs@kosagi.com>");
+MODULE_DESCRIPTION("ITE IT6251 LVDS to DisplayPort bridge");
+MODULE_LICENSE("MIT");
