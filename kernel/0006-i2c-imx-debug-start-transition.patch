+		"M2=%02x/%02x M3=%02x/%02x "
+		"M4=%02x/%02x M5=%02x/%02x "
+		"M6=%02x/%02x M7=%02x/%02x\n",
+		i2c_imx->novena_start_i2sr[0],
+		i2c_imx->novena_start_i2cr[0],
+		i2c_imx->novena_start_i2sr[1],
+		i2c_imx->novena_start_i2cr[1],
+		i2c_imx->novena_start_i2sr[2],
+		i2c_imx->novena_start_i2cr[2],
+		i2c_imx->novena_start_i2sr[3],
+		i2c_imx->novena_start_i2cr[3],
+		i2c_imx->novena_start_i2sr[4],
+		i2c_imx->novena_start_i2cr[4],
+		i2c_imx->novena_start_i2sr[5],
+		i2c_imx->novena_start_i2cr[5],
+		i2c_imx->novena_start_i2sr[6],
