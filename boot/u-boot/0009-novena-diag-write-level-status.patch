diff --git a/arch/arm/mach-imx/mx6/ddr.c b/arch/arm/mach-imx/mx6/ddr.c
index 5a1258e..29f2a4b 100644
--- a/arch/arm/mach-imx/mx6/ddr.c
+++ b/arch/arm/mach-imx/mx6/ddr.c
@@ -112,6 +112,9 @@ int mmdc_do_write_level_calibration(struct mx6_ddr_sysinfo const *sysinfo)
 	u32 ldectrl[4] = {0};
 	u32 ddr_mr1 = 0x4;
 	u32 rwalat_max;
+	int wl_wait_ret;
+	u32 wl_gcr0, wl_gcr1 = 0;
+	u32 wl_hwerr0, wl_hwerr1 = 0;
 
 	/*
 	 * Stash old values in case calibration fails,
@@ -167,16 +170,30 @@ int mmdc_do_write_level_calibration(struct mx6_ddr_sysinfo const *sysinfo)
 	 * 7. Upon completion of this process the MMDC de-asserts
 	 * the MPWLGCR[HW_WL_EN]
 	 */
-	wait_for_bit_le32(&mmdc0->mpwlgcr, 1 << 0, 0, 100, 0);
+	wl_wait_ret = wait_for_bit_le32(&mmdc0->mpwlgcr,
+					1 << 0, 0, 100, 0);
+
+	wl_gcr0 = readl(&mmdc0->mpwlgcr);
+	wl_hwerr0 = readl(&mmdc0->mpwlhwerr);
+
+	if (sysinfo->dsize == 2) {
+		wl_gcr1 = readl(&mmdc1->mpwlgcr);
+		wl_hwerr1 = readl(&mmdc1->mpwlhwerr);
+	}
+
+	printf("NOVENA-DIAG WL wait=%d gcr0=%08x hwerr0=%08x "
+	       "gcr1=%08x hwerr1=%08x\n",
+	       wl_wait_ret, wl_gcr0, wl_hwerr0,
+	       wl_gcr1, wl_hwerr1);
 
 	/*
 	 * 8. check for any errors: check both PHYs for x64 configuration,
 	 * if x32, check only PHY0
 	 */
-	if (readl(&mmdc0->mpwlgcr) & 0x00000F00)
+	if (wl_gcr0 & 0x00000F00)
 		errors |= 1;
 	if (sysinfo->dsize == 2)
-		if (readl(&mmdc1->mpwlgcr) & 0x00000F00)
+		if (wl_gcr1 & 0x00000F00)
 			errors |= 2;
 
 	debug("Ending write leveling calibration. Error mask: 0x%x\n", errors);
diff --git a/board/kosagi/novena/novena_spl.c b/board/kosagi/novena/novena_spl.c
index 7d2342f..82b76f2 100644
--- a/board/kosagi/novena/novena_spl.c
+++ b/board/kosagi/novena/novena_spl.c
@@ -543,6 +543,7 @@ static void ccgr_init(void)
  */
 void board_init_f(ulong dummy)
 {
+	int wl_ret;
 	/* setup AIPS and disable watchdog */
 	arch_cpu_init();
 
@@ -580,6 +581,7 @@ void board_init_f(ulong dummy)
 
 	/* Perform DDR DRAM calibration */
 	udelay(100);
-	mmdc_do_write_level_calibration(&novena_ddr_info);
+	wl_ret = mmdc_do_write_level_calibration(&novena_ddr_info);
+	printf("NOVENA-DIAG WL ret=%d\n", wl_ret);
 	mmdc_do_dqs_calibration(&novena_ddr_info);
 }
