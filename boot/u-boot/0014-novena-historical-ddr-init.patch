+/*
+ * NOVENA-DDR-IMPLEMENT-168: bd5c7d3290bb94bf8af17760c321df67d2641343.
+ * Preserve historical PHY1 MDMISC restore, MAPSR masks, chip-width IOMUX,
+ * integer timing, WL softfail and unbounded polling deliberately.
+ * These are reproduction choices, not fixes or hardware qualifications.
+ * All writable tables have nonzero initializers (.data); SPD is on stack.
+ */
+void novena_ddr_init(int spd_i2c_ret);
+
+void novena_ddr_init(int spd_i2c_ret)
+{
+	int wl_ret, dqs_ret;
+
+	novena_read_spd(&novena_ddr_info, &novena_ddr3_cfg, spd_i2c_ret);
+	novena_dram_iocfg(novena_ddr3_cfg.width,
+			 &novena_ddr_ioregs, &novena_grp_ioregs);
+	novena_dram_cfg(&novena_ddr_info, &novena_mmdc_calib,
+			&novena_ddr3_cfg);
+	wl_ret = do_write_level_calibration();
+	dqs_ret = do_dqs_calibration();
+	/* Observe only; historical continuation on errors is preserved. */
+	printf("NOVENA-DDR historical WL=%d DQS=%d\n", wl_ret, dqs_ret);
+	printf("Running post-config memory test... ");
+	if (novena_memory_test())
+		printf("Fail!\n");
+	else
+		printf("Pass\n");
