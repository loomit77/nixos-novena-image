+enum boot_device {
+	MX6_SD0_BOOT,
+	MX6_SD1_BOOT,
+	MX6_MMC_BOOT,
+	MX6_NAND_BOOT,
+	MX6_SATA_BOOT,
+	MX6_WEIM_NOR_BOOT,
