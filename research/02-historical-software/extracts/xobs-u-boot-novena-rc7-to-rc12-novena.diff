+
+static enum boot_device get_boot_device(void)
+{
+	struct src *psrc = (struct src *)SRC_BASE_ADDR;
+	unsigned soc_sbmr = readl(&psrc->sbmr1);
+	uint bt_mem_ctl = (soc_sbmr & 0x000000FF) >> 4 ;
+	uint bt_mem_type = (soc_sbmr & 0x00000008) >> 3;
+	uint bt_mem_mmc = (soc_sbmr & 0x00001000) >> 12;
+
+	switch (bt_mem_ctl) {
+	case 0x0:
+		if (bt_mem_type)
+			return MX6_ONE_NAND_BOOT;
+		else
+			return MX6_WEIM_NOR_BOOT;
+		break;
+	case 0x2:
+			return MX6_SATA_BOOT;
+		break;
+	case 0x3:
+		if (bt_mem_type)
+			return MX6_I2C_BOOT;
+		else
+			return MX6_SPI_NOR_BOOT;
+		break;
+	case 0x4:
+	case 0x5:
+		if (bt_mem_mmc)
+			return MX6_SD0_BOOT;
+		else
+			return MX6_SD1_BOOT;
+		break;
+	case 0x6:
+	case 0x7:
+		return MX6_MMC_BOOT;
+		break;
+	case 0x8 ... 0xf:
+		return MX6_NAND_BOOT;
+		break;
+	default:
+		return MX6_UNKNOWN_BOOT;
+		break;
+	}
+}
