+{ stdenv
+, fetchFromGitHub
+, linuxHeaders
+}:
+stdenv.mkDerivation rec {
+  pname = "it6251-dump-dptx";
+  version = "70b07ef";
+
+  src = fetchFromGitHub {
+    owner = "xobs";
+    repo = pname;
+    rev = version;
+    sha256 = "175q4lc6c7yqqksy68v70h8rskikhf9l2phbw8v2l5vcsk3q8w8k";
+  };
+
+  buildInputs = [ linuxHeaders ];
